# Logging
LOG_LEVEL=info

# Opengist
OPENGIST_URL=https://gist.example.com
OPENGIST_TOKEN=og_xxxxxxxx
OPENGIST_GIST_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# GitHub
GH_TOKEN=github_pat_xxxxxxxx

# hermes-decomp release tag to pin (default: latest)
HERMES_DECOMP_TAG=v0.2.2

# TEMP: unpatched debug branch — remove with TEMP_SHOULD_PUSH_TO_UNPATCHED_BRANCH
TEMP_SHOULD_PUSH_TO_UNPATCHED_BRANCH=false

# Discord
WEBHOOK_DISCORD_UNI=https://discord.com/api/webhooks/xxx/yyy
